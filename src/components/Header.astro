---
import type { SiteSettings } from '../lib/types';
import { trialMessage, whatsappUrl } from '../lib/whatsapp';

type Props = {
  settings: SiteSettings;
  currentPath: string;
};

const { settings, currentPath } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/programs', label: 'Programs' },
  { href: '/fixtures', label: 'Fixtures' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/contact', label: 'Contact' },
];
const trialHref = whatsappUrl(trialMessage, settings.whatsappNumber);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Goal Getters FC home">
    <img src={settings.logo} alt="Goal Getters FC crest" width="64" height="64" />
    <span>Goal Getters FC</span>
  </a>

  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span></span>
    <span></span>
    <span></span>
    <span class="sr-only">Open navigation</span>
  </button>

  <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
    {nav.map((item) => (
      <a href={item.href} class:list={{ active: currentPath === item.href }}>
        {item.label}
      </a>
    ))}
  </nav>

  <a class="header-cta" href={trialHref} target="_blank" rel="noopener">Book a Trial</a>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('open', !isOpen);
  });
</script>
