---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
---

<BaseLayout title="Page Not Found" description="The requested Goal Getters FC page could not be found." currentPath="/404" settings={settings}>
  <section class="page-hero">
    <div class="container">
      <h1>Page Not Found</h1>
      <p>This page is not available. Return to the club website home page.</p>
      <div class="hero-actions">
        <a class="btn" href="/">Back Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
